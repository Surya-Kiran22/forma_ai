# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For local dev without MongoDB installed, fallback to MongoMemoryServer is supported automatically
MONGODB_URI=mongodb://localhost:27017/forma_ai

# Security / Auth Configuration
JWT_SECRET=forma-ai-super-secret-jwt-key-32-chars-min
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=forma-ai-super-secret-refresh-key-min-32-chars
JWT_REFRESH_EXPIRATION=7d
CORS_ORIGIN=http://localhost:5173

# LLM Extraction Provider ('mock' or 'openai')
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Frontend Configuration (for frontend/.env)
VITE_API_BASE_URL=http://localhost:5000/api/v1
